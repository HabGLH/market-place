MONGO_URL=mongodb://127.0.0.1:27017/marketplace
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_LIFE=15m
CLIENT_URL=http://localhost:5173
CHAPA_SECRET_KEY=replace-with-your-chapa-test-secret
CHAPA_WEBHOOK_SECRET=replace-with-your-chapa-webhook-secret
SHIPPING_FEE_ETB=100
FREE_SHIPPING_THRESHOLD_ETB=5000
PORT=5000
NODE_ENV=development
# Set these in .env before running `npm run seed:admin`:
ADMIN_NAME=Marketplace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password